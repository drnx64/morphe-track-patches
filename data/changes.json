    {
      "bundle": "xob0t",
      "channel": "dev",
      "badge_type": "UPDATED",
      "apps": [
        {
          "app_name": "Avito",
          "package": "com.avito.android",
          "badge_type": "UPDATED APP",
          "patch_diff": {
            "patches_added": [],
            "patches_removed": [],
            "patches_modified": [
              {
                "name": "AMOLED dark theme",
                "description": "Makes dark-theme page, app navigation and system bars pure black (AMOLED) while keeping elevated cards, sheets and controls gray so their boundaries remain visible.",
                "changes": [
                  "versions: -5 versions"
                ]
              },
              {
                "name": "Block listings",
                "description": "Hides Avito offers from blacklisted adverts or sellers and adds a blacklist manager (import/export compatible with the Ave Blacklist extension).",
                "changes": [
                  "versions: -5 versions"
                ]
              },
              {
                "name": "Disable telemetry",
                "description": "Disables Avito first-party clickstream analytics and Avito's direct Adjust telemetry wrapper.",
                "changes": [
                  "options: -1 option",
                  "versions: -5 versions"
                ]
              },
              {
                "name": "Disable update prompts",
                "description": "Prevents Avito's force-update screen opener from launching update screens. Toggleable in Настройки Morphe.",
                "changes": [
                  "versions: -5 versions"
                ]
              },
              {
                "name": "Hide professional sellers",
                "description": "Adds a maximum seller review count to Avito search filters and hides or dims offers from sellers above that limit.",
                "changes": [
                  "versions: -5 versions"
                ]
              },
              {
                "name": "Morphe settings",
                "description": "Adds a \"Настройки Morphe\" entry to Avito's settings that hosts the configuration for the other Morphe patches.",
                "changes": [
                  "options: -1 option",
                  "versions: -5 versions"
                ]
              },
              {
                "name": "Remove ads",
                "description": "Disables Avito ads by removing ad SDK entry points and short-circuiting commercial banner loading.",
                "changes": [
                  "versions: -5 versions"
                ]
              },
              {
                "name": "UI tweaks",
                "description": "Optional interface tweaks, each toggleable in Настройки Morphe: single-row home categories, hide the \"Подписки\" tab in Избранное, hide installments (Рассрочка) and the \"Спросите у продавца\" block on offers, expand descriptions by default (no \"Читать далее\"), hide offer recommendations, hide profile raffle, referral and Avito Pro promos, and hide the Avi assistant tab in the bottom navigation.",
                "changes": [
                  "options: -1 option",
                  "versions: -5 versions"
                ]
              }
            ]
          },
          "scan_numbers": [
            1
          ]
        },
